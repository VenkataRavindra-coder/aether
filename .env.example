# AETHER .env template. Copy to .env, fill secrets, chmod 600. Never commit .env.
# What each limit means and why: strategy.md
# Alpaca paper (keys start PK)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Alpaca live (keys start AK) - only used when US_LIVE=true
APCA_LIVE_API_KEY_ID=
APCA_LIVE_API_SECRET_KEY=
# Access
WEBHOOK_SECRET=
DASHBOARD_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_SAS_URL=
# Crypto engine (shadow unless LIVE_TRADING=true; crypto real money blocked regardless)
STRATEGY_ENABLED=true
LIVE_TRADING=false
STRATEGY_RISK_PCT=1
STRATEGY_MAX_DAILY_LOSS_PCT=3
STRATEGY_COOLDOWN_SECONDS=7200
STRATEGY_INTERVAL_SECONDS=60
STRATEGY_SHADOW_EQUITY=100000
# TradingView webhook
TRADE_NOTIONAL_USD=100
MAX_ORDER_PCT=5
# US ETF engine
US_ENABLED=true
US_EXECUTE=true
US_ALLOCATION_USD=5000
US_CHECK_INTERVAL_SECONDS=300
US_REQUIRE_APPROVAL=true
US_LIVE=false
US_LIVE_MAX_USD=100
# Risk Controller (real-money limits)
RISK_MAX_ORDER_USD_LIVE=100
RISK_MAX_DAILY_BUY_USD_LIVE=100
# Optional: DIGEST_HOUR_UTC HEALTHCHECK_PING_URL MONITOR_SERVICES TELEGRAM_API_BASE
