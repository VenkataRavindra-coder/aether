# AETHER .env template. Copy to .env, fill secrets, chmod 600. Never commit .env.
# What each limit means and why: strategy.md
# Alpaca paper (keys start PK)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Alpaca live (keys start AK). Put these two lines in .env.live (chmod 600), NOT here: only
# aether.service, canary.py, live_check.py and risk_mark.py/risk_admin.py load .env.live, so the
# other timers never receive real-money keys. (Left in .env they still work, just less isolated.)
# APCA_LIVE_API_KEY_ID=
# APCA_LIVE_API_SECRET_KEY=
# Access
WEBHOOK_SECRET=
DASHBOARD_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_SAS_URL=
# Crypto engine (shadow unless LIVE_TRADING=true; crypto real money blocked regardless)
STRATEGY_ENABLED=true
LIVE_TRADING=false
STRATEGY_RISK_PCT=1
STRATEGY_MAX_DAILY_LOSS_PCT=3
STRATEGY_COOLDOWN_SECONDS=7200
STRATEGY_INTERVAL_SECONDS=60
STRATEGY_SHADOW_EQUITY=100000
# TradingView webhook
TRADE_NOTIONAL_USD=100
MAX_ORDER_PCT=5
# US ETF engine
US_ENABLED=true
US_EXECUTE=true
US_ALLOCATION_USD=5000
US_CHECK_INTERVAL_SECONDS=300
US_REQUIRE_APPROVAL=true
US_LIVE=false
US_LIVE_MAX_USD=100
# Risk Controller (real-money limits)
RISK_MAX_ORDER_USD_LIVE=100
RISK_MAX_DAILY_BUY_USD_LIVE=100
# Off-VM dead-man ping (healthchecks.io): used by the engine AND watchdog.py; test plan RD4 checks it.
HEALTHCHECK_URL=
# Optional: DIGEST_HOUR_UTC MONITOR_SERVICES TELEGRAM_API_BASE (HEALTHCHECK_PING_URL = legacy alias)

# Read-only SPY 200-session macro trend endpoint (/signal/SPY). Never submits orders.
ALPACA_MODE=paper
ALPACA_DATA_FEED=iex
ALPACA_HTTP_TIMEOUT_SECONDS=8
SPY_SMA_LOOKBACK_CALENDAR_DAYS=420
MACRO_SIGNAL_CACHE_SECONDS=60
# For live data, set ALPACA_MODE=live and ensure only aether.service loads
# APCA_LIVE_API_KEY_ID / APCA_LIVE_API_SECRET_KEY from mode-600 .env.live.
