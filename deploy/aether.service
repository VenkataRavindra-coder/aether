[Unit]
Description=AETHER autonomous trading engine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
# notify (not simple): the app calls sd_notify READY=1 once started and WATCHDOG=1 at the
# end of every successful monitor cycle. WatchdogSec below depends on this.
Type=notify
User=ratelark
WorkingDirectory=/home/ratelark/ratelark
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ratelark/ratelark/.venv/bin/python3 -m uvicorn aether_engine:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=always
RestartSec=5
# If WATCHDOG=1 stops arriving (the process hangs, not just crashes -- e.g. a thread
# stuck holding a lock) for this long, systemd kills and restarts it. Comfortably above
# MONITOR_INTERVAL (60s) so normal jitter never trips it.
WatchdogSec=180
# 310s: the shutdown sequence in aether_engine.py's lifespan() joins the strategy/US
# threads for up to 300s so an in-flight live order (submit + fill poll) isn't severed
# mid-flight by the interpreter exiting. Must stay >= that join timeout, or systemd
# SIGKILLs the process before the join returns.
TimeoutStopSec=310
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
