[Unit]
Description=AETHER stress test on the dedicated stress account (paper, weekdays)
After=network-online.target

[Service]
Type=oneshot
User=ratelark
WorkingDirectory=/home/ratelark/ratelark
EnvironmentFile=/home/ratelark/ratelark/.env
ExecStart=/bin/bash /home/ratelark/ratelark/run_stress.sh
TimeoutStartSec=1500
Nice=10
